
@model ProyectoFinalMatricula_ValverdeAmanda.Models.Docente

@{
    ViewData["Title"] = "Eliminar docente";
}

<div class="modulo-card">
    <h2>Eliminar docente</h2>
    <p>¿Estás seguro de que deseas eliminar este registro?</p>
    <hr />

    <p><strong>Nombre:</strong> @Model.Nombre @Model.Apellidos</p>
    <p><strong>Correo:</strong> @Model.Correo</p>
    <p><strong>Teléfono:</strong> @Model.Telefono</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="DocenteId" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
