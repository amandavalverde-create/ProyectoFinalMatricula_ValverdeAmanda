
@model IEnumerable<ProyectoFinalMatricula_ValverdeAmanda.Models.Docente>

@{
    ViewData["Title"] = "Docentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Docentes</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Inicio</a>
</div>

<a asp-action="Create" class="btn btn-primary mb-3">Agregar docente</a>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Apellidos</td>
            <td>@item.Correo</td>
            <td>@item.Telefono</td>
            <td>@(item.Estado ? "Activo" : "Inactivo")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DocenteId">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.DocenteId">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.DocenteId">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
