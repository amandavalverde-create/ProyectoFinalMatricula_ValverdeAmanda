@model IEnumerable<ProyectoFinalMatricula_ValverdeAmanda.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <h1>Estudiantes</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-house-fill"></i> Regresar al inicio
    </a>
</div>

<a asp-action="Create" class="btn btn-primary mb-4">
    <i class="bi bi-plus-circle-fill"></i> Agregar estudiante
</a>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Identificación</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Carrera</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre @item.Apellidos</td>
                    <td>@item.Identificacion</td>
                    <td>@item.Correo</td>
                    <td>@item.Telefono</td>
                    <td>@(item.Carrera?.Nombre ?? "Sin carrera")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.EstudianteId">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.EstudianteId">Detalles</a> |
                        <a asp-action="Delete" asp-route-id="@item.EstudianteId">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
