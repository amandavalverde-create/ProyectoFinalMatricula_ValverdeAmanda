
@model ProyectoFinalMatricula_ValverdeAmanda.Models.Matricula

@{
    ViewData["Title"] = "Editar matrícula";
}

<div class="modulo-card">
    <h2>Editar matrícula</h2>
    <hr />

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MatriculaId" />

        <div class="mb-3">
            <label asp-for="EstudianteId" class="form-label">Estudiante</label>
            <select asp-for="EstudianteId" asp-items="ViewBag.Estudiantes" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="CursoId" class="form-label">Curso</label>
            <select asp-for="CursoId" asp-items="ViewBag.Cursos" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="FechaMatricula" class="form-label">Fecha</label>
            <input asp-for="FechaMatricula" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="Activa">Activa</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Cancelada">Cancelada</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
