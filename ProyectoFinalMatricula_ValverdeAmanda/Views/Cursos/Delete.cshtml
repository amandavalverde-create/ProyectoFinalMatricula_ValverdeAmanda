@model ProyectoFinalMatricula_ValverdeAmanda.Models.Curso

@{
    ViewData["Title"] = "Eliminar curso";
}

<div class="mb-4">
    <h1>Eliminar curso</h1>
    <p class="text-muted">Revise la información antes de confirmar la eliminación.</p>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                ¿Está seguro de que desea eliminar este curso?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Código</dt>
                <dd class="col-sm-8">@Model.CursoId</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.Descripcion</dd>

                <dt class="col-sm-4">Créditos</dt>
                <dd class="col-sm-8">@Model.Creditos</dd>

                <dt class="col-sm-4">Carrera</dt>
                <dd class="col-sm-8">@(Model.Carrera?.Nombre ?? "Sin carrera")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="CursoId" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash-fill"></i> Confirmar eliminación
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </form>

        </div>
    </div>
</div>
